# Copy this to .env.local for local development. On Vercel, these are set
# under Project Settings -> Environment Variables instead.

TELEGRAM_BOT_TOKEN=
GEMINI_API_KEY=
GROQ_API_KEY=
TELEGRAM_WEBHOOK_SECRET=

# Your own numeric Telegram chat id — the sole admin, exempt from all tier
# limits, who can ban (and unban) anyone else via /users and /remove.
# Everyone else is auto-approved on first contact and starts on Free tier
# immediately (see db/schema.js's access_requests table / lib/access.js) —
# this used to be an invite-only bot with a manual approve/deny flow;
# that's gone now that it's public.
OWNER_CHAT_ID=

# Added for the mini app's chat storage (Neon Postgres). On Vercel this gets
# set automatically when you connect a Neon database through the Storage
# tab — you only need to set this by hand for local development.
DATABASE_URL=

# Added for the mini app frontend itself. Set this to your deployed URL,
# e.g. https://your-project.vercel.app/miniapp/index.html — /start won't
# show the "Open Chat App" button until this is set.
MINI_APP_URL=

# Your bot's @username (no @), e.g. assist_ai_bot. Used to build the
# shareable https://t.me/<username>?start=ref_<id> links for /invite —
# without it, /invite still works but falls back to a plain referral code
# the friend has to paste in manually.
TELEGRAM_BOT_USERNAME=

# Your announcement channel's @username (no @), e.g. assist_ai_updates.
# Powers /channelbonus — a free user who joins gets +3 image generations/
# month for 30 days, renewable by re-running the command. Leave unset to
# turn the feature off entirely; /channelbonus will say so plainly rather
# than erroring. The bot must be an admin of the channel (or the channel
# must be public) for getChatMember to work.
TELEGRAM_CHANNEL_USERNAME=

# Added for file/photo uploads in the mini app (Vercel Blob). Like
# DATABASE_URL, Vercel sets this automatically once you connect a Blob
# store through the Storage tab — create a NEW store for this project,
# not the one from any other project you have. Only set this by hand for
# local development.
BLOB_READ_WRITE_TOKEN=

# Both optional — power the mini app's 🔍 Search toggle (see README's
# "Web search" section for setup). Leave either or both unset and the
# chain just skips past them: SearXNG -> Tavily -> Gemini's own built-in
# search grounding (reuses GEMINI_API_KEY above, no separate key needed).
# If all three end up unavailable for a given search, the bot answers
# without search context rather than erroring the message out.
SEARXNG_URL=
TAVILY_API_KEY=

# All three optional — extra free-tier text providers in the mini app's
# chat fallback chain (Groq -> Cerebras -> OpenRouter -> Mistral ->
# Gemini, see lib/ai.js). Leave any unset and the chain just skips past
# it with no network call, same pattern as the search keys above. Adding
# one is the only step needed to turn it on — no other code change.
#
# CEREBRAS_API_KEY: same gpt-oss-120b model as Groq, but heads up — as of
# mid-2026 Cerebras dropped its no-card free tier. A new account now
# needs a verified payment method to unlock a one-time $5 credit that
# expires in 30 days, not an ongoing free allowance. Check current terms
# at cloud.cerebras.ai (not console.cerebras.ai) before deciding whether
# that's worth it for you; leaving this unset skips Cerebras entirely.
#
# OPENROUTER_API_KEY: also gpt-oss-120b, via the free "openai/gpt-oss-
# 120b:free" route. openrouter.ai/keys. Free tier is 20 requests/minute,
# 50/day — the jump to 1,000/day needs an *actual purchase* of $10+ in
# credits through a real payment method; setting a "credit limit" on a
# key by itself doesn't count; that's just a spending cap on the key, not
# a balance.
#
# MISTRAL_API_KEY: a different model (Mistral Small) with by far the
# largest free pool (~1B tokens/month) of the four — but unlike the
# others, Mistral's free "Experiment" tier uses your prompts to improve
# their models unless your workspace opts out under Admin Console ->
# Privacy. Decide on that before setting this one; leaving it unset skips
# Mistral entirely, no code change needed. console.mistral.ai.
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=

# Both optional, image-vision-only (no text-chat use) — extra fallback
# links in getVisionReply's chain (lib/ai.js) for when Gemini's ~20/day
# vision quota runs out and Mistral/OpenRouter's vision routes are also
# down or out of budget. Unlike the keys above, these two aren't reused
# from anywhere else — each needs its own signup.
#
# MODELSCOPE_API_KEY: Alibaba's model hub, 2,000 requests/day (500/day per
# model) — genuinely no card needed, but signup wants phone verification
# that in practice usually means a Chinese number; real friction for most
# international accounts. modelscope.cn/my/myaccesstoken — same token
# works for both their SDK and this REST API, despite the two names.
#
# ZAI_API_KEY: Z.ai (formerly Zhipu) — sign up at z.ai specifically, not
# bigmodel.cn (that's the China-only domain that wants a Chinese phone).
# GLM-4.6V-Flash is genuinely free, no card, but tightly rate-limited on
# most accounts — treat it as a last-resort link, not a primary. Key from
# the API Keys page under your z.ai profile menu.
MODELSCOPE_API_KEY=
ZAI_API_KEY=
