# Copy this to .env.local for local development. On Vercel, these are set
# under Project Settings -> Environment Variables instead.

TELEGRAM_BOT_TOKEN=
GEMINI_API_KEY=
GROQ_API_KEY=
TELEGRAM_WEBHOOK_SECRET=

# Your own numeric Telegram chat id — the sole admin, exempt from all tier
# limits, who can ban (and unban) anyone else via /users and /remove.
# Everyone else is auto-approved on first contact and starts on Free tier
# immediately (see db/schema.js's access_requests table / lib/access.js) —
# this used to be an invite-only bot with a manual approve/deny flow;
# that's gone now that it's public.
OWNER_CHAT_ID=

# Added for the mini app's chat storage (Neon Postgres). On Vercel this gets
# set automatically when you connect a Neon database through the Storage
# tab — you only need to set this by hand for local development.
DATABASE_URL=

# Added for the mini app frontend itself. Set this to your deployed URL,
# e.g. https://your-project.vercel.app/miniapp/index.html — /start won't
# show the "Open Chat App" button until this is set.
MINI_APP_URL=

# Your bot's @username (no @), e.g. assist_ai_bot. Used to build the
# shareable https://t.me/<username>?start=ref_<id> links for /invite —
# without it, /invite still works but falls back to a plain referral code
# the friend has to paste in manually.
TELEGRAM_BOT_USERNAME=

# Your announcement channel's @username (no @), e.g. assist_ai_updates.
# Powers /channelbonus — a free user who joins gets +3 image generations/
# month for 30 days, renewable by re-running the command. Leave unset to
# turn the feature off entirely; /channelbonus will say so plainly rather
# than erroring. The bot must be an admin of the channel (or the channel
# must be public) for getChatMember to work.
TELEGRAM_CHANNEL_USERNAME=

# Added for file/photo uploads in the mini app (Vercel Blob). Like
# DATABASE_URL, Vercel sets this automatically once you connect a Blob
# store through the Storage tab — create a NEW store for this project,
# not the one from any other project you have. Only set this by hand for
# local development.
BLOB_READ_WRITE_TOKEN=

# Both optional — power the mini app's 🔍 Search toggle (see README's
# "Web search" section for setup). Leave either or both unset and the
# chain just skips past them: SearXNG -> Tavily -> Gemini's own built-in
# search grounding (reuses GEMINI_API_KEY above, no separate key needed).
# If all three end up unavailable for a given search, the bot answers
# without search context rather than erroring the message out.
SEARXNG_URL=
TAVILY_API_KEY=

# All three optional — extra free-tier text providers in the mini app's
# chat fallback chain (Groq -> Cerebras -> OpenRouter -> Mistral ->
# Gemini, see lib/ai.js). Leave any unset and the chain just skips past
# it with no network call, same pattern as the search keys above. Adding
# one is the only step needed to turn it on — no other code change.
#
# CEREBRAS_API_KEY: same gpt-oss-120b model as Groq, but heads up — as of
# mid-2026 Cerebras dropped its no-card free tier. A new account now
# needs a verified payment method to unlock a one-time $5 credit that
# expires in 30 days, not an ongoing free allowance. Check current terms
# at cloud.cerebras.ai (not console.cerebras.ai) before deciding whether
# that's worth it for you; leaving this unset skips Cerebras entirely.
#
# OPENROUTER_API_KEY: a free-model fallback (currently Google's Gemma 4 — see
# OPENROUTER_MODEL below; the old openai/gpt-oss-120b:free route was withdrawn).
# openrouter.ai/keys. Free tier is 20 requests/minute,
# 50/day — the jump to 1,000/day needs an *actual purchase* of $10+ in
# credits through a real payment method; setting a "credit limit" on a
# key by itself doesn't count; that's just a spending cap on the key, not
# a balance.
#
# MISTRAL_API_KEY: a different model (Mistral Small) with by far the
# largest free pool (~1B tokens/month) of the four — but unlike the
# others, Mistral's free "Experiment" tier uses your prompts to improve
# their models unless your workspace opts out under Admin Console ->
# Privacy. Decide on that before setting this one; leaving it unset skips
# Mistral entirely, no code change needed. console.mistral.ai.
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=

# Both optional, image-vision-only (no text-chat use) — extra fallback
# links in getVisionReply's chain (lib/ai.js) for when Gemini's ~20/day
# vision quota runs out and Mistral/OpenRouter's vision routes are also
# down or out of budget. Unlike the keys above, these two aren't reused
# from anywhere else — each needs its own signup.
#
# MODELSCOPE_API_KEY: Alibaba's model hub, 2,000 requests/day (500/day per
# model) — genuinely no card needed, but signup wants phone verification
# that in practice usually means a Chinese number; real friction for most
# international accounts. modelscope.cn/my/myaccesstoken — same token
# works for both their SDK and this REST API, despite the two names.
# If /health live reports "key rejected (HTTP 401)", the token is wrong,
# expired, or the account hasn't finished ModelScope's verification — the
# message shown after "401" is ModelScope's own and says which.
#
# ZAI_API_KEY: Z.ai (formerly Zhipu) — sign up at z.ai specifically, not
# bigmodel.cn (that's the China-only domain that wants a Chinese phone).
# GLM-4.6V-Flash is genuinely free, no card, but tightly rate-limited on
# most accounts — treat it as a last-resort link, not a primary. Key from
# the API Keys page under your z.ai profile menu.
MODELSCOPE_API_KEY=
ZAI_API_KEY=

# Extra (Premium model tier) runs on the free Gemini quota shared by everyone:
# four Flash models x 20 requests/day each = about 80 replies a day in total.
# Site-wide cap on Extra replies per rolling 24h — roughly 3/4 of that. Check
# your numbers: aistudio.google.com/usage?timeRange=last-28-days&tab=rate-limit
# Optional; default 60.
EXTRA_SITE_DAILY_CAP=

# ---------------------------------------------------------------------------
# CLOUDFLARE WORKERS AI  (optional — BOTH of the next two, or neither)
# Powers: the Cloudflare text models in the chat fallback chain, image
# understanding, and image generation (FLUX). Free plan = 10,000 "neurons" a
# day for everything together; the bot stops using it at 9,000
# (CF_NEURON_DAILY_CAP below). Unset -> Cloudflare is simply skipped.
#
# How to get them (Cloudflare's current "REST API" quick-start):
#   1. Sign up / log in at https://dash.cloudflare.com (free, no card needed
#      for the free neuron allowance).
#   2. In the left sidebar open  AI -> Workers AI  (or go straight to
#      https://dash.cloudflare.com/?to=/:account/ai/workers-ai ).
#   3. Click  "Use REST API".
#   4. Click  "Create a Workers AI API Token" -> review the pre-filled
#      permissions -> "Create API Token" -> "Copy API Token".  Paste it as
#      CLOUDFLARE_API_TOKEN. Copy it NOW: Cloudflare shows the secret once.
#      (Making a custom token instead? It needs BOTH "Workers AI - Read" and
#      "Workers AI - Edit".)
#   5. On that same page, under "Get Account ID", copy the Account ID. Paste it
#      as CLOUDFLARE_ACCOUNT_ID. (It's also in the dashboard's account home.)
#   6. Add both to Vercel -> redeploy -> send /health to the bot to confirm.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ---------------------------------------------------------------------------
# OPTIONAL TUNABLES — you do NOT need to set any of these. Each has a built-in
# default (shown); set one only to change it. They are listed here so you know
# they exist. Leave blank/commented to keep the default.
# ---------------------------------------------------------------------------

# Cloudflare image generation
#   CF_IMAGE_MODEL  default @cf/black-forest-labs/flux-1-schnell
#   CF_IMAGE_STEPS  default 4  (1-8; more steps = slightly better picture but
#                   +9.6 neurons per step, ~58 neurons per image at 4)
# CF_IMAGE_MODEL=
# CF_IMAGE_STEPS=

# Cloudflare text/vision model ids (Workers AI retires models; a retired id just
# 404s and the chain moves on — /health tells you when that happens)
#   CF_STANDARD_MODEL default @cf/openai/gpt-oss-120b
#   CF_FLASH_MODEL    default @cf/meta/llama-3.1-8b-instruct-fp8-fast
#   CF_VISION_MODEL   default @cf/google/gemma-4-26b-a4b-it
# CF_STANDARD_MODEL=
# CF_FLASH_MODEL=
# CF_VISION_MODEL=
#   CF_NEURON_DAILY_CAP default 9000 (of Cloudflare's free 10,000)
# CF_NEURON_DAILY_CAP=

# Groq fast-mode model and OpenRouter's free models. These ids CHANGE: Groq shut down llama-3.1-8b-instant
# on 16 Aug 2026, and OpenRouter withdrew gpt-oss-120b:free and qwen2.5-vl:free. When /health says one is
# gone, set a current id here (no code change needed) and redeploy.
#   GROQ_FLASH_MODEL         default openai/gpt-oss-20b   (Groq's own replacement for the retired Llama 8B)
#   OPENROUTER_MODEL         default google/gemma-4-31b-it:free      (text fallback)
#   OPENROUTER_VISION_MODEL  default google/gemma-4-26b-a4b-it:free  (image-question fallback)
#   OpenRouter ids MUST end in ":free" — anything else is ignored, because it would bill your credit.
#   Current free models: openrouter.ai/models -> filter "Free". Free ones come and go with little notice.
# GROQ_FLASH_MODEL=
# OPENROUTER_MODEL=
# OPENROUTER_VISION_MODEL=

# Mistral model ids (pinned on purpose — the "-latest" aliases can silently move
# to a model with a far lower rate limit) and the monthly spend guard
#   MISTRAL_SMALL_MODEL default mistral-small-2603      MISTRAL_LARGE_MODEL default mistral-large-2512
#   MISTRAL_14B_MODEL   default ministral-14b-2512      MISTRAL_8B_MODEL    default ministral-8b-2512
#   MISTRAL_MONTHLY_BUDGET_USD default 8.5 (of the free plan's $10 credit)
# MISTRAL_SMALL_MODEL=
# MISTRAL_LARGE_MODEL=
# MISTRAL_14B_MODEL=
# MISTRAL_8B_MODEL=
# MISTRAL_MONTHLY_BUDGET_USD=

# Site-wide daily caps (all users together) — protect the shared free quotas
#   FILE_SITE_DAILY_CAP  default 150  files the whole bot may create/edit per rolling 24h
#   (EXTRA_SITE_DAILY_CAP, default 60, is set further up)
# FILE_SITE_DAILY_CAP=

# Plans, trials and allowance
#   PRO_PROMO_SLOTS        default 100  first N people who can claim the 14-day Pro promo
#   TRIAL_DAILY_START_CAP  default 20   new trials started per rolling 24h, all users together
#   TOKEN_WINDOW_DAYS      default 30   length of the rolling token-allowance window
# PRO_PROMO_SLOTS=
# TRIAL_DAILY_START_CAP=
# TOKEN_WINDOW_DAYS=

# What the bot calls itself in messages. Default: Assist AI
# BOT_NAME=

# ---------------------------------------------------------------------------
# SET BY VERCEL ITSELF — never add these by hand, and they never appear in the
# Environment Variables list:
#   VERCEL_ENV              production / preview / development
#   VERCEL_GIT_COMMIT_SHA   the deployed commit (only used to refresh the mini
#                           app's cached page; falls back to a timestamp)
# They only exist if Project Settings -> Environment Variables -> "Automatically
# expose System Environment Variables" is ticked. The bot works either way (it
# also looks at NODE_ENV), and /health shows which case you're in.
# ---------------------------------------------------------------------------
