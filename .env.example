# Copy this to .env.local for local development. On Vercel, these are set
# under Project Settings -> Environment Variables instead.

TELEGRAM_BOT_TOKEN=
GEMINI_API_KEY=
GROQ_API_KEY=
TELEGRAM_WEBHOOK_SECRET=

# Your own numeric Telegram chat id — the sole admin, exempt from all tier
# limits, who can ban (and unban) anyone else via /users and /remove.
# Everyone else is auto-approved on first contact and starts on Free tier
# immediately (see db/schema.js's access_requests table / lib/access.js) —
# this used to be an invite-only bot with a manual approve/deny flow;
# that's gone now that it's public.
OWNER_CHAT_ID=

# Added for the mini app's chat storage (Neon Postgres). On Vercel this gets
# set automatically when you connect a Neon database through the Storage
# tab — you only need to set this by hand for local development.
DATABASE_URL=

# Added for the mini app frontend itself. Set this to your deployed URL,
# e.g. https://your-project.vercel.app/miniapp/index.html — /start won't
# show the "Open Chat App" button until this is set.
MINI_APP_URL=

# Your bot's @username (no @), e.g. assist_ai_bot. Used to build the
# shareable https://t.me/<username>?start=ref_<id> links for /invite —
# without it, /invite still works but falls back to a plain referral code
# the friend has to paste in manually.
TELEGRAM_BOT_USERNAME=

# Your announcement channel's @username (no @), e.g. assist_ai_updates.
# Powers /channelbonus — a free user who joins gets +3 image generations/
# month for 30 days, renewable by re-running the command. Leave unset to
# turn the feature off entirely; /channelbonus will say so plainly rather
# than erroring. The bot must be an admin of the channel (or the channel
# must be public) for getChatMember to work.
TELEGRAM_CHANNEL_USERNAME=

# Added for file/photo uploads in the mini app (Vercel Blob). Like
# DATABASE_URL, Vercel sets this automatically once you connect a Blob
# store through the Storage tab — create a NEW store for this project,
# not the one from any other project you have. Only set this by hand for
# local development.
BLOB_READ_WRITE_TOKEN=

# Both optional — power the mini app's 🔍 Search toggle (see README's
# "Web search" section for setup). Leave either or both unset and the
# chain just skips past them: SearXNG -> Tavily -> Gemini's own built-in
# search grounding (reuses GEMINI_API_KEY above, no separate key needed).
# If all three end up unavailable for a given search, the bot answers
# without search context rather than erroring the message out.
SEARXNG_URL=
TAVILY_API_KEY=
